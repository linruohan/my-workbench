{
  "name": "my-workbench",
  "private": true,
  "version": "0.1.10",
  "description": "Local-first personal workbench",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test -w @wb/domain && npm run test -w @wb/db && npm run test -w @wb/theme && npm run test -w @wb/desktop",
    "test:domain": "npm run test -w @wb/domain",
    "test:db": "npm run test -w @wb/db",
    "test:theme": "npm run test -w @wb/theme",
    "dev": "npm run dev -w @wb/desktop",
    "dev:desktop": "npm run tauri:dev -w @wb/desktop",
    "build": "npm run build -w @wb/desktop",
    "typecheck": "npm run typecheck -w @wb/domain && npm run typecheck -w @wb/db && npm run typecheck -w @wb/theme && npm run typecheck -w @wb/desktop",
    "lint": "npm run lint -w @wb/desktop",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,css,json}\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "tauri:dev": "npm run tauri:dev -w @wb/desktop",
    "pack:win": "npm run tauri:build -w @wb/desktop",
    "pack:check": "npm run check && npm run build -w @wb/desktop",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true
  }
}

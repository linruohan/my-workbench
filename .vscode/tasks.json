{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "桌面端: Vite 热更新",
      "type": "npm",
      "script": "dev",
      "path": "apps/desktop/",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "桌面端: Tauri 热启动",
      "type": "shell",
      "command": "npm run tauri:dev -w @wb/desktop",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "TAURI_DEBUG": "1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true
    }
  ]
}

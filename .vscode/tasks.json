{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "工作台: 运行",
      "type": "shell",
      "command": "cargo run -p wb-app",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "工作台: 门禁",
      "type": "shell",
      "command": "cargo fmt --check && cargo clippy --workspace -- -D warnings && cargo test --workspace",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}

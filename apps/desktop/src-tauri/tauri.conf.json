{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "My Workbench",
  "version": "0.1.11",
  "identifier": "com.myworkbench.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "个人工作台",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/speech/transcribe.mjs",
      "resources/speech/funasr_worker.py",
      "resources/speech/qwenctc_worker.py",
      "resources/speech/runtimes",
      "resources/speech/assets"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
